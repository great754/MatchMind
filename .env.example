# Used only with --commentary-provider gemini. Keep .env untracked.
GEMINI_API_KEY=

# Optional server-side Microsoft adapter. Never place real values in HTML or git.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
MATCHMIND_PROVIDER=local
MATCHMIND_API_TOKEN=

# Optional online artifact/media configuration (trusted server paths).
MATCHMIND_REGISTRY=configs/serving/local.json
MATCHMIND_ARTIFACT_STORE=local
MATCHMIND_MEDIA_ROOT=
# Optional private Azure videos, using MATCHMIND_BLOB_ACCOUNT_URL and Entra auth.
# For the existing uploaded clips set this to soccertrack-v2.
MATCHMIND_MEDIA_BLOB_CONTAINER=
MATCHMIND_BLOB_ACCOUNT_URL=
MATCHMIND_BLOB_CONTAINER=matchmind
MATCHMIND_RECORDINGS=["118575_clip","128058_clip","132831_clip","117092_clip","117093_clip","118576_clip","118577_clip","118578_clip","128057_clip","132877_clip"]
MATCHMIND_CACHE=/tmp/matchmind-artifacts
# Optional Agent Framework SDK/project path; not live-verified.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
